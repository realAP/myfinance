# Vorlage fuer die Stage-Konfiguration. In Coolify werden diese Werte je
# Stack gesetzt - dev und prod unterscheiden sich nur hier, nicht in
# compose.yaml.

# Welcher Stand ausgeliefert wird. "dev" und "latest" sind wandernde Zeiger,
# eine SHA ist unveraenderlich. Eine Promotion bedeutet: die SHA, die auf dev
# gut war, hier eintragen - ohne Neubau.
IMAGE_TAG=dev
# IMAGE_REPOSITORY=devp1337/myfinance

# Datenbank
DATABASE_NAME=myfinance
DATABASE_USER=myfinance
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://db:5432/myfinance

# Anmeldung an der Anwendung (HTTP Basic, ein Benutzer)
APP_USER=
APP_PASSWORD=
SPRING_PROFILE=prod

# Sicherung
ENV_TARGET_DOMAIN=
ENV_TARGET_DOMAIN_USER=
ENV_SSH_PRIVATE_KEY_BASE64=
ENV_RESTIC_REPOSITORY_NAME=
ENV_RESTIC_PASSWORD=
ENV_PROVISION_MODE=
ENV_POSTGRES_USER=
ENV_POSTGRES_PASSWORD=
ENV_POSTGRES_DATABASE=
ENV_TELEGRAM_TOKEN=
ENV_TELEGRAM_CHAT_ID=
ENV_CRON=
