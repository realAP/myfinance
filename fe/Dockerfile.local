# Nur fuer die lokale Entwicklung, siehe be/Dockerfile.local.

FROM node:24-alpine AS build
WORKDIR /src
# Feste Version statt "corepack enable": Corepack zoege sonst das neueste
# pnpm. Ab 12 ist das allowBuilds-Feld aus pnpm-workspace.yaml unbekannt und
# die Installation bricht ab. Die Pipeline faehrt ebenfalls 11.
RUN npm install -g pnpm@11
# pnpm-workspace.yaml muss mit: dort steht allowBuilds, ohne das
# pnpm die Installationsskripte von esbuild und Co. verweigert.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM nginx:alpine
COPY --from=build /src/dist/fe/browser /usr/share/nginx/html
COPY ./nginx.conf.template /etc/nginx/templates/default.conf.template
ENV BACKEND_URL=http://be:8080
CMD ["nginx", "-g", "daemon off;"]
